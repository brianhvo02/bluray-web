{
  "name": "bluray-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ass": "playwright test -c playwright.ass.config.ts",
    "wasm:build": "src/wasm/audio/build.sh && src/wasm/freetype/build.sh",
    "wasm:build:audio": "src/wasm/audio/build.sh",
    "wasm:build:freetype": "src/wasm/freetype/build.sh",
    "vm-trace:build": "tools/vm-trace/build.sh",
    "bdj-trace:build": "tools/bdj-trace/build.sh",
    "bdj-classlib:build": "tools/bdj-classlib/build.sh",
    "bdj-classlib:collect": "tools/bdj-classlib/collect.sh",
    "vm-trace:golden": "tools/vm-trace/golden.sh",
    "bdj-trace:golden": "tools/bdj-trace/golden.sh",
    "bdj-trace:freetype-golden": "tools/bdj-trace/freetype-golden.sh",
    "vm-trace": "tsx tests/vm-trace/run.ts",
    "bdj-trace": "tsx tests/bdj/run.ts",
    "ass-trace:build": "tools/ass-trace/build.sh",
    "ass-trace:golden": "tools/ass-trace/golden.sh",
    "ass-trace": "tsx tests/ass-trace/run.ts",
    "disc-server": "tsx tools/disc-server/server.ts",
    "fixture:synthetic": "tsx scripts/make-audio-fixtures.ts && tsx scripts/make-fixture-disc.ts fixtures/synthetic/disc1 && tsx scripts/make-error-fixtures.ts && tsx scripts/make-bframe-disc.ts fixtures/synthetic/disc2 && tsx scripts/make-audio-disc.ts fixtures/synthetic/disc3 && tsx scripts/make-vm-disc.ts fixtures/synthetic/disc-vm && tsx scripts/make-menu-disc.ts fixtures/synthetic/disc-menu && tsx scripts/make-subs-disc.ts fixtures/synthetic/disc-subs && tsx scripts/make-bdj-disc.ts fixtures/synthetic/disc-bdj && tsx scripts/make-bdj-mixed-disc.ts fixtures/synthetic/disc-bdj-mixed"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "pixelmatch": "^7.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.0.4",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
