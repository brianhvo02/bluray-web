# Copy to .env next to compose.yaml and set your values. Lines starting with # are comments; empty values mean unset.

# The folders the scanner reads, comma-separated name=/library/<folder>, optionally name=/library/<folder>@Group
# (roots sharing a group show as one top-level folder). Paths are inside the container, under /library.
LIBRARY_ROOTS=movies=/library/BDMVs,downloads=/library/Downloads@Downloads
# The host folder bound read-only at /library.
LIBRARY_MOUNT=/srv/bluray
# Required. The server's HTTPS API base as devices reach it, ending in /api/.
PUBLIC_BASE=https://nas.example.com/bluray/api/
# The player that pairing links open (default: the hosted player).
APP_URL=https://bluray-web.pages.dev/
# Your rendezvous Worker, for pairing by typed code or QR and for the WebRTC route. Empty: pairing links only.
RENDEZVOUS_URL=
# This host's LAN address, advertised to WebRTC peers on the same network (with RENDEZVOUS_URL).
RTC_LAN_ADDRESS=192.168.1.20
# The UDP port of the WebRTC route; forward it to this host on your router.
RTC_PORT=47998
# The host name of a reverse proxy that reaches the server (its address is then trusted for forwarding headers). Empty: none.
TRUSTED_PROXY=
# Time zone of the nightly scan.
TZ=Etc/UTC
# When the nightly scan runs, HH:MM in TZ.
NIGHTLY_SCAN_AT=04:00
# Who may open the title library: everyone (every paired person) or owners.
TITLE_LIBRARY=everyone
# TheMovieDB key for title matching. Empty: no TMDB lookups.
TMDB_API_KEY=
# Discogs token for music lookups. Empty: MusicBrainz only.
DISCOGS_TOKEN=
# A contact address or URL named in the User-Agent of music lookups, as MusicBrainz asks. Printable ASCII. Empty: none.
LOOKUP_CONTACT=
# Quality levels: qsv (Intel Quick Sync, needs compose.gpu.yaml) or off (Original only).
LEVELS_BACKEND=off
# The server image. Pin a tag for a fixed version.
BLURAY_IMAGE=ghcr.io/brianhvo02/bluray-server:latest
