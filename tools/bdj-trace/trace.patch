 /* this automatically generated header is included to cross-check native function signatures */
 #include "org_videolan_Libbluray.h"
 
+/* bdj-trace: one JSONL line per native call */
+#include <stdio.h>
+#include <unistd.h>
+
+/* JSON string literal for a UTF-8 string, malloc'ed ("null" for NULL) */
+char *bdj_json_str(const char *s)
+{
+    static const char hex[] = "0123456789abcdef";
+    if (!s) {
+        return strdup("null");
+    }
+    char *out = malloc(strlen(s) * 6 + 3), *p = out;
+    *p++ = '"';
+    for (const unsigned char *c = (const unsigned char *)s; *c; c++) {
+        if (*c == '"' || *c == '\\') {
+            *p++ = '\\';
+            *p++ = (char)*c;
+        } else if (*c < 0x20) {
+            *p++ = '\\'; *p++ = 'u'; *p++ = '0'; *p++ = '0';
+            *p++ = hex[*c >> 4];
+            *p++ = hex[*c & 15];
+        } else {
+            *p++ = (char)*c;
+        }
+    }
+    *p++ = '"';
+    *p = 0;
+    return out;
+}
+
+/* BDJ_TRACE_UNTIL=<call>: stop the process right after the first line for that call */
+void bdj_trace(const char *call, const char *args, const char *ret)
+{
+    const char *until = getenv("BDJ_TRACE_UNTIL");
+    printf("{\"call\":\"%s\",\"args\":[%s],\"ret\":%s}\n", call, args, ret);
+    fflush(stdout);
+    if (until && !strcmp(until, call)) {
+        _exit(0);
+    }
+}
+#define _trace bdj_trace
+
 /* Disable some warnings */
 #if defined __GNUC__
 #pragma GCC diagnostic ignored "-Wunused-parameter"
